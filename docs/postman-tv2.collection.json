{
  "info": {
    "name": "TV2 - Validation, Auth and Courses",
    "description": "Collection kiểm thử validation, error handler, authentication, rate limit và CRUD Courses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "courseId", "value": "1" }
  ],
  "item": [
    {
      "name": "Login - lấy Admin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đăng nhập thành công', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@uni.edu\",\"password\":\"123456\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Validation - body không hợp lệ",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/debug/validate"
      }
    },
    {
      "name": "Error - 404 route không tồn tại",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/route-khong-ton-tai"
      }
    },
    {
      "name": "Error - 500 không lộ chi tiết",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/debug/crash"
      }
    },
    {
      "name": "Courses - GET danh sách",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Courses - POST tạo mới",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tạo môn học thành công', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('courseId', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"courseCode\":\"POSTMAN101\",\"name\":\"Kiem thu Postman\",\"credits\":3}"
        },
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Courses - POST trùng mã (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"courseCode\":\"POSTMAN101\",\"name\":\"Mon bi trung\",\"credits\":3}"
        },
        "url": "{{baseUrl}}/api/v1/courses"
      }
    },
    {
      "name": "Courses - GET chi tiết",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
      }
    },
    {
      "name": "Courses - PATCH cập nhật",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"credits\":4}" },
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
      }
    },
    {
      "name": "Courses - DELETE xóa",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
      }
    },
    {
      "name": "Login - sai quá 5 lần (lần 6 trả 429)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@uni.edu\",\"password\":\"sai\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    }
  ]
}

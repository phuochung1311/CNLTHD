{
  "info": {
    "name": "Member 2 - Validation and Error Handler",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Validation - invalid body",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/debug/validate"
      }
    },
    {
      "name": "Validation - valid body",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\":\"An\"}" },
        "url": "{{baseUrl}}/api/v1/debug/validate"
      }
    },
    {
      "name": "Async error",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/debug/async-error"
      }
    },
    {
      "name": "Not found",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/route-khong-ton-tai"
      }
    },
    {
      "name": "Rate limit",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/ping"
      }
    }
  ]
}

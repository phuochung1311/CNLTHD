{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run TV2 Jest tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"--runInBand"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Validate TV2 additions",
			"type": "shell",
			"command": "npx",
			"args": [
				"jest",
				"tests/valdiations-error.test.js",
				"tests/course.service.test.js",
				"tests/login-rate-limit.test.js",
				"--runInBand"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Validate TV2 Postman JSON",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"JSON.parse(require('fs').readFileSync('docs/postman-tv2.collection.json','utf8')); console.log('Postman collection JSON: valid')"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Parse TV2 Postman collection",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Content 'docs/postman-tv2.collection.json' -Raw | ConvertFrom-Json | Out-Null; Write-Output 'Postman collection JSON: valid'"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Retest login rate limit",
			"type": "shell",
			"command": "npx",
			"args": [
				"jest",
				"tests/login-rate-limit.test.js",
				"--runInBand"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Verify auth token fix",
			"type": "shell",
			"command": "npx",
			"args": [
				"jest",
				"tests/auth.test.js",
				"--runInBand"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}